name: Production

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: read
  actions: read

concurrency:
  group: goalgo-production
  cancel-in-progress: false

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - id: image-run
        uses: actions/github-script@v8
        with:
          script: |
            for (let attempt = 1; attempt <= 60; attempt++) {
              const { data } = await github.rest.actions.listWorkflowRuns({
                owner: context.repo.owner,
                repo: context.repo.repo,
                workflow_id: 'images.yml',
                head_sha: context.sha,
                per_page: 10
              });
              const runs = data.workflow_runs;
              if (runs.length === 0 || runs[0].status !== 'completed') {
                core.info(`Waiting for Images run for ${context.sha} (${attempt}/60)`);
                await new Promise(resolve => setTimeout(resolve, 15000));
                continue;
              }
              if (runs[0].conclusion !== 'success') {
                throw new Error(`Images run ${runs[0].id} concluded with ${runs[0].conclusion}`);
              }
              core.setOutput('run-id', runs[0].id);
              return;
            }
            throw new Error(`Timed out waiting for Images run for ${context.sha}`);
      - uses: actions/download-artifact@v4
        with:
          pattern: release-manifest-*
          path: artifact
          merge-multiple: true
          github-token: ${{ github.token }}
          run-id: ${{ steps.image-run.outputs.run-id }}
      - name: Verify manifest and create release environment
        run: |
          test "$(jq -r .backendCommit artifact/release-manifest.json)" = "$GITHUB_SHA"
          image='registry.cn-hangzhou.aliyuncs.com/sanenchen/goalgo@sha256:[0-9a-f]{64}'
          jq -e --arg image "$image" '.images | all(.[]; test($image))' artifact/release-manifest.json >/dev/null
          jq -r '"FRONTEND_IMAGE=" + .images.frontend,
                 "GATEWAY_IMAGE=" + .images.gateway,
                 "USER_IMAGE=" + .images.user,
                 "CORE_DATA_IMAGE=" + .images.coreData,
                 "AGENT_IMAGE=" + .images.agent' artifact/release-manifest.json > artifact/release.env
      - uses: actions/upload-artifact@v4
        with:
          name: production-release
          path: artifact/release.env
          retention-days: 1
          if-no-files-found: error

  deploy:
    needs: release
    environment: production
    runs-on: [self-hosted, linux, x64, goalgo-production]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: production-release
          path: release
      - name: Deploy immutable release
        env:
          GOALGO_ROOT: /opt/goalgo
        run: deploy/scripts/deploy.sh "$GITHUB_WORKSPACE/release/release.env"
